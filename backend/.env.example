# ParleyAI backend — copy to .env and set paths to your downloaded models.
# Example tuned for laptop: i7 + 32GB RAM + 8GB RTX 4070. Works on Linux, Windows, macOS.
# Paths: use forward slashes or your OS native path (e.g. C:\Models\... on Windows); Python accepts both on Windows. See MODEL_RECOMMENDATIONS.md for download links.

# ============== Text / LLM (story, chat) ==============
# Set to your GGUF path; use model_family_text=custom for a single file. Examples: /home/user/models/model.gguf (Linux), C:/Models/model.gguf (Windows), ~/models/model.gguf (any).
model_path_text=/path/to/L3-Grand-Story-Darkness-MOE-4X8-24.9B-e32-D_AU-Q4_k_m.gguf
model_family_text=custom
# quant_text only used when model_path_text is a directory (e.g. Qwen from a folder)
quant_text=Q4_K_M
# Context window (prompt + output). Story API uses max_tokens=4096 — ctx must be >= that + prompt. 2048 truncates 30–90 sec stories; use 4096 so full JSON (title, description, many scenes) fits. If OOM on 8GB, try gpu_layers_text=16.
# On 8GB VRAM: ctx_text=8192 uses ~1GB for KV cache → fewer layers on GPU → ~2–4 tok/s. For 15–25+ tok/s (Grand-Story) or 20–30 (Qwen 32B) use ctx_text=2048 or 4096 and gpu_layers_text=-1 (or 28–32).
ctx_text=4096
gpu_layers_text=20
# Only has effect if text backend has GPU: llama-server = CUDA build (Windows); llama-cpp-python = built with CUDA. CPU-only builds ignore it (CPU/RAM spike, no GPU). Logs show "GPU Layers: N (from gpu_layers_text)". Verify: python backend/check_gpu_setup.py
batch_size_text=512

# ============== TTS ==============
# edge = no download (cloud). piper = local .onnx voice file (set model_path_tts below).
tts_engine=edge
model_path_tts=
# Edge: en-US-JennyNeural (EN), hi-IN-MadhurNeural (HI). Piper: e.g. en_US-lessac-medium (used when tts_engine=piper).
voice_id_tts=en-US-JennyNeural

# ============== Image (text-to-image) ==============
# Laptop: SD 1.5 fits 8GB. HF id or local path (e.g. ./models/stable-diffusion-v1-5).
model_path_image=runwayml/stable-diffusion-v1-5
width_image=512
height_image=512
steps_image=25
# Leave empty for GPU; set to -1 for CPU-only.
cuda_visible_devices_image=

# ============== Video (image-to-video) ==============
# Laptop: SVD XT with decode_chunk_size_video=2 for 8GB VRAM.
model_path_video=stabilityai/stable-video-diffusion-img2vid-xt
num_frames_video=25
fps_video=6
decode_chunk_size_video=2
motion_bucket_id_video=127
noise_aug_strength_video=0.02
# Leave empty for GPU; set to -1 to run video model on CPU only.
cuda_visible_devices_video=
# On 8 GB VRAM: video model auto-uses CPU offload + chunking. Force with video_cpu_offload=1.
# video_cpu_offload=1

# ============== Shared / server (laptop-friendly) ==============
gpu_unload_after_idle_sec=30
# When using llama-server (LFM2, Qwen, Mistral, custom): stop subprocess after N seconds idle to free RAM/VRAM. 0 = never auto-stop.
LFM_IDLE_TIMEOUT=300
gpu_allow_image_and_video_concurrent=0
text_lazy_load=1
port=8000

enable_text=1
enable_tts=1
enable_image=1
enable_video=1

# Legacy (fallback if *_text / *_image etc. not set)
# MODEL_PATH=/path/to/L3-Grand-Story-Darkness-MOE-4X8-24.9B-e32-D_AU-Q4_k_m.gguf
# MODEL_FAMILY=custom
# QUANT=Q4_K_M
# CTX=4096
# GPU_LAYERS=20
# BATCH_SIZE=512
# TTS_ENGINE=edge
# PIPER_VOICE_PATH=
# IMAGE_MODEL_ID=runwayml/stable-diffusion-v1-5
# VIDEO_MODEL_ID=stabilityai/stable-video-diffusion-img2vid-xt

# ============== Tunnel (full-stack only: start.sh / start_windows.bat) ==============
# Used when you run ./start.sh or .\start_windows.bat (not when running backend only via python backend/run.py).
# TUNNEL=on              Expose app via public URL (cloudflared or localtunnel)
# TUNNEL_TOOL=auto       auto, cloudflared, or localtunnel
# SUBDOMAIN=parley-ai     Custom subdomain for localtunnel (e.g. parley-ai.loca.lt)
# TUNNEL=off
# TUNNEL_TOOL=auto
# SUBDOMAIN=
